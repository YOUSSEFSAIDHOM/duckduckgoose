@startuml
class Player {
    float x
    float y
    int size
    float speed
    float sprintSpeed
    int health
    void update()
    void draw()
}

class Goose {
    float x
    float y
    int size
    int speed
    void chasePlayer
    void separate()
    void checkCollision()
    void update()
    void draw()
}

class EnergyDrink {
  float efficacyDuration
}

class BirdSeeds {
  float radiusOfEffect
  int noOfGeeseAffected
}

abstract AbstractItem {
    bool equipped
    void use()
}

EnergyDrink --|> AbstractItem : Extends
BirdSeeds --|> AbstractItem : Extends

Player .. Goose : Interacts

Player --> EnergyDrink : Uses
Player --> BirdSeeds : Uses

@enduml
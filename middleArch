@startuml
class GameMap {
    float tile_size
    TiledMap map
    OrthogonalTiledMapRenderer renderer
    Vector2 playerSpawn
    float width
    float height
    float getWidth()
    float getHeight()
    Rectangle[] getWalls()
    void loadSpawn()
    void loadBorders()
    void getPlayerSpawn()
    void render()
    void dispose()

}

class Player {
  float x
  float y
  float size
  float bounds
  float xVelocity
  float yVelocity
  float health
  int speed
  int sprintSpeed
  int currentSpeed
  bool alive
  AbstractItem[] hotbar
  AbstractItem currentItem
  
  float getX()
  float getY()
  float getSize()
  bool checkWallCollision()

  void wallPush()
  void update()
  draw()
  getHealth()
  increaseHealth()
  decreaseHealth()
  pickUpItem()
  holdItem()
  useItem()

}

class Goose {
  float x
  float y
  float size
  float bounds
  int speed
  float distance
  float dx
  float dy
  bool chasing
  bool checkCollision()

  void wallPush()
  float getX()
  float getY()
  float getSize()
  bool checkWallCollision()
  void chasePlayer()
  void separate()
  void update()
  void draw()
}

abstract AbstractItem {
  bool equipped
  void dispose()
  void use()
  void setEquipped()
  void update()
  void draw()
}

class EnergyDrink {
  float efficacyDuration
}

class BirdSeeds {
  float radiusOfEffect
  int noOfGeeseAffected
}
BirdSeeds --|> AbstractItem : Extends
EnergyDrink --|> AbstractItem : Extends

Player -- Goose : Interacts with
Player -- EnergyDrink : Uses
Player -- BirdSeeds : Uses

Player -- GameMap : Interacts with
Goose -- GameMap : Interacts with

@enduml